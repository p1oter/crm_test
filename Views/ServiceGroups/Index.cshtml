@model IEnumerable<CRM.Models.ServiceGroup>

@{
    ViewData["Title"] = "Kategorie Usług";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">+ Nowa Kategoria</a>
        </div>
    </div>

    @if (Model.Any())
    {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nazwa</th>
                            <th>Liczba Usług</th>
                            <th>Liczba Umiejętności</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        var serviceCount = item.Services?.Count ?? 0;
                        var skillCount = item.EmployeeSkills?.Count ?? 0;
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.Name</td>
                                    <td>
                                @if (serviceCount > 0)
                                {
                                                <span class="badge bg-success">@serviceCount</span>
                                }
                                else
                                {
                                                <span class="text-muted">-</span>
                                }
                                    </td>
                                    <td>
                                @if (skillCount > 0)
                                {
                                                <span class="badge bg-info">@skillCount</span>
                                }
                                else
                                {
                                                <span class="text-muted">-</span>
                                }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                            Podgląd
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            Edytuj
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                            Usuń
                                        </a>
                                    </td>
                                </tr>
                    }
                    </tbody>
                </table>
            </div>
    }
    else
    {
            <div class="alert alert-info">
                Brak kategorii usług w bazie danych.
            </div>
    }
</div>