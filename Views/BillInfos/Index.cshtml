@model IEnumerable<CRM.Models.BillInfo>

@{
    ViewData["Title"] = "Informacje Rozliczeniowe";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1>@ViewData["Title"]</h1>
        </div>
    </div>

    @if (Model.Any())
    {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID Klienta</th>
                            <th>Imię i Nazwisko</th>
                            <th>Email</th>
                            <th>Numer Konta</th>
                            <th>Saldo (PLN)</th>
                            <th>Liczba Płatności</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                                <tr>
                                    <td>@item.ClientId</td>
                                    <td>@item.Client?.FirstName @item.Client?.LastName</td>
                                    <td>@item.Client?.Email</td>
                                    <td>
                                        <code>@item.BankAccount</code>
                                    </td>
                                    <td>
                                @if (item.Balance.HasValue)
                                {
                                                <span class="badge @(item.Balance >= 0 ? "bg-success" : "bg-danger")">
                                        @item.Balance.Value.ToString("F2") zł
                                                </span>
                                }
                                else
                                {
                                                <span class="text-muted">-</span>
                                }
                                    </td>
                                    <td>
                                                <span class="badge bg-info">@(item.Payments?.Count ?? 0)</span>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.ClientId" class="btn btn-sm btn-info">
                                            Szczegóły
                                        </a>
                                    </td>
                                </tr>
                    }
                    </tbody>
                </table>
            </div>
    }
    else
    {
            <div class="alert alert-info">
                Brak informacji rozliczeniowych w bazie danych.
            </div>
    }
</div>