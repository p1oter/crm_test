@model CRM.Models.Service

@{
    ViewData["Title"] = "Nowa Usługa";
    var serviceGroups = ViewData["ServiceGroups"] as List<CRM.Models.ServiceGroup>;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>

            <form asp-action="Create" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Nazwa usługi <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label">Cena <span class="text-danger">*</span></label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ServiceGroupId" class="form-label">Kategoria <span class="text-danger">*</span></label>
                        <select asp-for="ServiceGroupId" class="form-select" required>
                            <option value="">-- Wybierz kategorię --</option>
                            @if (serviceGroups != null)
                            {
                                @foreach (var group in serviceGroups)
                                {
                                            <option value="@group.Id">@group.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ServiceGroupId" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Dodaj usługę</button>
                    <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}