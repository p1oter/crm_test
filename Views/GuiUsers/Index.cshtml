@model IEnumerable<CRM.Models.GuiUser>
@{
    ViewData["Title"] = "Użytkownicy GUI";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">+ Nowe konto</a>
        </div>
    </div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Login</th>
            <th>Pracownik</th>
            <th>Rola</th>
            <th >Akcje</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td class="align-middle">@u.Login</td>
                <td class="align-middle">@u.EmployeeId</td>
                <td class="align-middle">@u.RoleId</td>
                <td class="align-middle">
                        <a asp-action="Details" asp-route-id="@u.Login" class="btn btn-sm btn-info">
                        <i class="bi bi-eye"></i> Szczegóły
                    </a>
                        <a asp-action="Edit" asp-route-id="@u.Login" class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil"></i> Edytuj
                    </a>
                    <a asp-action="Delete" asp-route-id="@u.Login" class="btn btn-sm btn-danger">
                        <i class="bi bi-trash"></i> Usuń
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>