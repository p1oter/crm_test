@model CRM.Models.Reservation

@{
    ViewData["Title"] = "Szczegóły Rezerwacji";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>

            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Data i Godzina</dt>
                        <dd class="col-sm-9">@Model.StartT.ToString("dd.MM.yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Pracownik</dt>
                        <dd class="col-sm-9">@Model.Employee?.FirstName @Model.Employee?.LastName</dd>

                        <dt class="col-sm-3">Klient</dt>
                        <dd class="col-sm-9">@Model.Client?.FirstName @Model.Client?.LastName</dd>

                        <dt class="col-sm-3">Usługa</dt>
                        <dd class="col-sm-9">@Model.Service?.Name</dd>

                        <dt class="col-sm-3">Cena</dt>
                        <dd class="col-sm-9">@Model.Service?.Price?.ToString("C")</dd>
                    </dl>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edytuj</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Usuń</a>
                <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
            </div>
        </div>
    </div>
</div>