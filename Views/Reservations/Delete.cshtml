@model CRM.Models.Reservation

@{
    ViewData["Title"] = "Usuwanie Rezerwacji";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1>@ViewData["Title"]</h1>

            <div class="alert alert-warning" role="alert">
                <strong>Uwaga!</strong> Ta operacja jest nieodwracalna.
            </div>

            <div class="card">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">ID</dt>
                        <dd class="col-sm-9">@Model.Id</dd>

                        <dt class="col-sm-3">Data/Godzina</dt>
                        <dd class="col-sm-9">@Model.StartT.ToString("dd.MM.yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Pracownik</dt>
                        <dd class="col-sm-9">@Model.Employee?.FirstName @Model.Employee?.LastName</dd>

                        <dt class="col-sm-3">Klient</dt>
                        <dd class="col-sm-9">@Model.Client?.FirstName @Model.Client?.LastName</dd>

                        <dt class="col-sm-3">Usługa</dt>
                        <dd class="col-sm-9">@Model.Service?.Name</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="DeleteConfirmed" method="post" class="mt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Usuń rezerwację</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </form>
        </div>
    </div>
</div>