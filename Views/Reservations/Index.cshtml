@model IEnumerable<CRM.Models.Reservation>

@{
    ViewData["Title"] = "Lista Rezerwacji";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">+ Nowa Rezerwacja</a>
        </div>
    </div>

    @if (Model.Any())
    {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Data/Godzina</th>
                            <th>Pracownik</th>
                            <th>Klient</th>
                            <th>Usługa</th>
                            <th>Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.StartT.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@item.Employee?.FirstName @item.Employee?.LastName</td>
                                    <td>@item.Client?.FirstName @item.Client?.LastName</td>
                                    <td>@item.Service?.Name</td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                            Podgląd
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            Edytuj
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                            Usuń
                                        </a>
                                    </td>
                                </tr>
                    }
                    </tbody>
                </table>
            </div>
    }
    else
    {
            <div class="alert alert-info">
                Brak rezerwacji w bazie danych.
            </div>
    }
</div>