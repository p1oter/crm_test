@using System.Globalization
@model CRM.Models.Invoice

@{
    ViewData["Title"] = "Edycja faktury";
    var clients = ViewData["Clients"] as List<CRM.Models.Client> ?? new List<CRM.Models.Client>();
    var createdValue = (Model?.CreatedT == default) ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm") : Model.CreatedT.ToString("yyyy-MM-ddTHH:mm");
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>@ViewData["Title"] - #@Model.Id</h1>
        </div>
    </div>

    <form asp-action="Edit" method="post" class="needs-validation" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

        <div class="card mb-4">
            <div class="card-header bg-primary text-white"><h5 class="mb-0">Dane faktury</h5></div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="ClientId" class="form-label">Klient <span class="text-danger">*</span></label>
                    <select asp-for="ClientId" class="form-select" required>
                        <option value="">-- Wybierz klienta --</option>
                        @foreach (var c in clients.OrderBy(x => x.FirstName))
                        {
        <option value="@c.Id" selected="@(Model != null && Model.ClientId == c.Id ? "selected" : null)">
                                @c.FirstName @c.LastName (@c.Email)
        </option>
                        }
                    </select>
                    <span asp-validation-for="ClientId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CreatedT" class="form-label">Data wystawienia <span class="text-danger">*</span></label>
                        <input asp-for="CreatedT" type="datetime-local" class="form-control" value="@createdValue" required />
                        <span asp-validation-for="CreatedT" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="DueT" class="form-label">Termin płatności</label>
                        <input asp-for="DueT" type="date" class="form-control" value="@(Model.DueT?.ToString("yyyy-MM-dd") ?? "")" />
                        <span asp-validation-for="DueT" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-success text-white"><h5 class="mb-0">Pozycje faktury</h5></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="invoice-lines-table" class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px">#</th>
                                <th>Usługa</th>
                                <th>Wykonawca</th>
                                <th style="width: 130px">Cena (PLN)</th>
                                <th style="width: 100px">Ilość</th>
                                <th style="width: 80px">Akcje</th>
                            </tr>
                        </thead>
                        <tbody id="invoice-lines-body">
                            @for (int i = 0; i < Model.Lines.Count; i++)
                            {
                                @Html.EditorFor(m => m.Lines[i])
                            }
                        </tbody>
                    </table>
                </div>

                <button type="button" id="add-invoice-line" class="btn btn-secondary">
                    <i class="bi bi-plus-circle"></i> Dodaj pozycję
                </button>
            </div>
        </div>

        <div class="mb-4">
            <button type="submit" class="btn btn-primary btn-lg">
                <i class="bi bi-save"></i> Zapisz zmiany
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg">Anuluj</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        (function () {
            // Reuse the same JS as in Create.cshtml for add/remove/reindex.
            var rowCount = document.querySelectorAll("#invoice-lines-body tr").length;

            function reindexRows() {
                var rows = document.querySelectorAll("#invoice-lines-body tr.invoice-line-row");
                rows.forEach((row, idx) => {
                    row.querySelector(".row-number").textContent = idx + 1;
                    row.querySelectorAll("select, input").forEach(field => {
                        var name = field.getAttribute("name");
                        if (name) {
                            var newName = name.replace(/Lines\[\d+\]/, "Lines[" + idx + "]");
                            field.setAttribute("name", newName);
                        }
                    });
                });
                rowCount = rows.length;
            }

            function addRow() {
                var lastRow = document.querySelector("#invoice-lines-body tr.invoice-line-row");
                if (!lastRow) return;
                var newRow = lastRow.cloneNode(true);
                newRow.querySelectorAll("input, select").forEach(field => {
                    if (field.type !== "hidden") field.value = "";
                });
                newRow.querySelectorAll(".field-validation-error, .field-validation-valid").forEach(span => span.textContent = "");
                document.querySelector("#invoice-lines-body").appendChild(newRow);
                reindexRows();
                // rebind events if any (not needed for simple selects)
            }

            document.getElementById("add-invoice-line").addEventListener("click", function (e) {
                e.preventDefault();
                addRow();
            });

            document.addEventListener("click", function (e) {
                var btn = e.target.closest(".remove-line");
                if (btn) {
                    e.preventDefault();
                    var rows = document.querySelectorAll("#invoice-lines-body tr.invoice-line-row");
                    if (rows.length <= 1) { alert("Faktura musi mieć co najmniej jedną pozycję."); return; }
                    btn.closest("tr").remove();
                    reindexRows();
                }
            });

            window.addEventListener("load", function () { reindexRows(); });
        })();
    </script>
}